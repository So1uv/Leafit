<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FitnessTracker" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- "Невидимий" splash: системний екран на Android 12+ прибрати повністю не можна,
         тому ховаємо іконку та зводимо тривалість до нуля -->
    <style name="Theme.FitnessTracker.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.FitnessTracker</item>
    </style>
</resources>
