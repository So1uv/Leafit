<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_sleep_background" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_icon" android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ms_bedtime" android:background="@drawable/widget_rosette" android:padding="8dp"
            android:tint="@color/widget_on_sleep" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="@string/widget_sleep" android:textSize="14sp" android:maxLines="2"
            android:fontFamily="@font/roboto_flex_600" android:textColor="@color/widget_text" />
    </LinearLayout>
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="48dp"
        android:text="—" android:maxLines="1" android:gravity="start|center_vertical" android:textSize="36sp"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="36sp"
        android:fontFamily="@font/roboto_flex_600" android:textColor="@color/widget_text" />
    <TextView android:id="@+id/widget_unit" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_sleep_latest" android:maxLines="1" android:textSize="12sp" android:fontFamily="@font/roboto_flex_500" android:textColor="@color/widget_muted" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/widget_sleep_empty" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"
        android:fontFamily="@font/roboto_flex_400" android:textColor="@color/widget_muted" />
</LinearLayout>
