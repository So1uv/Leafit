<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/notif_icon" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp"
            android:background="@drawable/notif_plate" android:tint="@color/notif_bar" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/notif_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Info" android:fontFamily="@font/roboto_flex_600"
                android:maxLines="1" android:ellipsize="end" />
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:id="@+id/notif_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title" android:textSize="32sp"
                    android:fontFamily="@font/roboto_flex_600" android:maxLines="1" android:includeFontPadding="false" />
                <Chronometer android:id="@+id/notif_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Compat.Notification.Title" android:textSize="32sp"
                    android:fontFamily="@font/roboto_flex_600" android:maxLines="1" android:includeFontPadding="false"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
        <TextView android:id="@+id/notif_percent" android:layout_width="wrap_content" android:layout_height="24dp"
            android:layout_marginStart="8dp" android:background="@drawable/notif_pill" android:gravity="center"
            android:paddingHorizontal="10dp" android:textSize="12sp" android:fontFamily="@font/roboto_flex_600"
            android:textColor="@color/notif_on_bar" android:maxLines="1" android:includeFontPadding="false" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/notif_caption" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.Compat.Notification.Info" android:maxLines="2"
        android:ellipsize="end" />
    <ProgressBar android:id="@+id/notif_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
        android:layout_height="16dp" android:layout_marginTop="10dp" android:progressDrawable="@drawable/notif_progress"
        android:max="100" android:progress="0" android:visibility="gone" />
    <LinearLayout android:id="@+id/notif_stats" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <TextView android:id="@+id/notif_stat1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:background="@drawable/notif_chip" android:gravity="center" android:paddingHorizontal="8dp" android:maxLines="1"
            android:ellipsize="end" android:textSize="13sp" android:fontFamily="@font/roboto_flex_600"
            android:textColor="@color/notif_chip_text" android:visibility="gone" />
        <TextView android:id="@+id/notif_stat2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:background="@drawable/notif_chip" android:gravity="center" android:paddingHorizontal="8dp" android:maxLines="1"
            android:ellipsize="end" android:textSize="13sp" android:fontFamily="@font/roboto_flex_600"
            android:textColor="@color/notif_chip_text" android:visibility="gone" android:layout_marginStart="4dp" />
        <TextView android:id="@+id/notif_stat3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:background="@drawable/notif_chip" android:gravity="center" android:paddingHorizontal="8dp" android:maxLines="1"
            android:ellipsize="end" android:textSize="13sp" android:fontFamily="@font/roboto_flex_600"
            android:textColor="@color/notif_chip_text" android:visibility="gone" android:layout_marginStart="4dp" />
    </LinearLayout>
    <TextView android:id="@+id/notif_tip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" android:maxLines="2" android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
